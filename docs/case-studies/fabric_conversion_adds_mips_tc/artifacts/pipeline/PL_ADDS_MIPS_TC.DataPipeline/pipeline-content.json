        "policy": {
          "timeout": "01:00:00",
          "retry": 2,
          "retryIntervalInSeconds": 60,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "source": {
            "type": "AzureSqlSource",
            "queryTimeout": "02:00:00",
            "isolationLevel": "ReadUncommitted",
            "sqlReaderQuery": "--MIPS TC\nSELECT \n       [Agency] AS [Agency]\n      ,[SubAgency] AS [SubAgency]\n\t  ,[Biennium] AS [Biennium]\n      --[Posting Fiscal Month]\n\t  ,CASE\n\t\tWHEN [PostingFiscalMonth] = '25' THEN '24' \n\t\tWHEN [PostingFiscalMonth] = '99' THEN '12' \n\t\tELSE [PostingFiscalMonth]\n\t  END AS [Posting Fiscal Month]\n\t  --[Posting Adjust Month]\n\t,CASE\n\t\tWHEN [PostingFiscalMonth] = '25' THEN '25' \n\t\tWHEN [PostingFiscalMonth] = '99' THEN '99' \n\t\tELSE 0\n\t  END AS [Posting Adjust Month]\n\t  ,CASE\n        WHEN LEN([AfrsDailyTransAddsId]) = 1\n            then replicate('0000000000',1)+cast([AfrsDailyTransAddsId] as varchar)  \n        WHEN LEN([AfrsDailyTransAddsId]) = 2\n            then replicate('000000000',1)+cast([AfrsDailyTransAddsId] as varchar) \n\t\tWHEN LEN([AfrsDailyTransAddsId]) = 3\n            then replicate('00000000',1)+cast([AfrsDailyTransAddsId] as varchar) \n        WHEN LEN([AfrsDailyTransAddsId]) = 4\n            then replicate('0000000',1)+cast([AfrsDailyTransAddsId] as varchar)\n\t\tWHEN LEN([AfrsDailyTransAddsId]) = 5\n            then replicate('000000',1)+cast([AfrsDailyTransAddsId] as varchar)\n\t\tWHEN LEN([AfrsDailyTransAddsId]) = 6\n            then replicate('00000',1)+cast([AfrsDailyTransAddsId] as varchar)\n\t\tWHEN LEN([AfrsDailyTransAddsId]) = 7\n            then replicate('0000',1)+cast([AfrsDailyTransAddsId] as varchar)\n\t\tWHEN LEN([AfrsDailyTransAddsId]) = 8\n            then replicate('000',1)+cast([AfrsDailyTransAddsId] as varchar)\n\t\tWHEN LEN([AfrsDailyTransAddsId]) = 9\n            then replicate('00',1)+cast([AfrsDailyTransAddsId] as varchar)\n\t\tWHEN LEN([AfrsDailyTransAddsId]) = 10\n            then replicate('0',1)+cast([AfrsDailyTransAddsId] as varchar)\n        ELSE\n            CAST([AfrsDailyTransAddsId] AS VARCHAR(1))\n\t  END AS [ADDS Transaction Key]  \n\t  ,[Fund] AS [Account]\n\t  ,'0' AS [Account Detail]\n\t  ,[OrganizationIndex] AS [Organization Index]\n\t  ,[AppropriationIndex] AS [Expenditure Authority Index]\n\t  ,[ProgramIndex] AS [Program Index]\n\t  ,[Project] AS [PrePurge Project]\n\t  ,[SubProject] AS [PrePurge SubProject]\n\t  ,[ProjectPhase] AS [PrePurge Project Phase]\n\t  ,'' AS [PrePurge Project Type]\n\t  ,[TransactionCode] AS [Transaction Code]\n\t  ,[Modifier] AS [Modifier]\n\t  ,[ReverseInd] AS [Reverse Code]\n\t  ,[MasterIndex] AS [Master Index]\n\t  ,[OMWBEType] AS [OMWBE Pay Flag]\n\t  ,0 AS [Master Index Percentage]\n\t  ,[VariableGLAccount] AS [Variable GL Account]\n\t  --[Input Fiscal Month]\n\t  ,CASE\n\t\tWHEN [BatchFiscalMonth] = '25' THEN '24' \n\t\tWHEN [BatchFiscalMonth] = '99' THEN '12' \n\t\tELSE [BatchFiscalMonth]\n\t  END AS [Input Fiscal Month]\n\t  --[Input Adjusting Month]\n\t,CASE\n\t\tWHEN [BatchFiscalMonth] = '25' THEN '25' \n\t\tWHEN [BatchFiscalMonth] = '99' THEN '99' \n\t\tELSE 0\n\t  END AS [Input Adjusting Month]\n\t  ,[MajorSource] AS [Major Source]\n\t  ,[Source] AS [Source]\n\t  ,[SubSource] AS [SubSource]\n\t  ,SUBSTRING([SubObject], 1, 1) AS [Object] \n\t  ,[SubObject] AS [SubObject]\n\t  ,[SubsubObject] AS [SubsubObject]\n\t  ,[VendorNum] AS [Vendor Num]\n\t  ,[VendorNumSuffix] AS [Vendor Num Suffix]\n\t  ,[VendorName] AS [Vendor Name]\n\t  ,[AgreementId] AS [Contract Num]\n\t  ,[IRSBox] AS [IRS Box]\n\t  ,[UseTax] AS [Use Tax]\n\t  ,[AgencyFlag] AS [Agency Flag]\n\t  ,[VendorTrailer] AS [Vendor Trailer]\n\t  ,[CurrentDocumentNum] AS [Current Document Num]\n\t  ,[CurrentDocumentNumSuffix] AS [Current Document Num Suffix]\n\t  ,CONVERT(varchar,[DocumentDate],112) AS [Doc Date]\n\t  ,[ReferenceDocumentNum] AS [Reference Doc Num]\n\t  ,[ReferenceDocumentNumSuffix] AS [Reference Doc Num Suffix]\n\t  ,[InvoiceNum] AS [Invoice Num]\n\t  ,CONVERT(varchar,[InvoiceDate],112) AS [Invoice Date]\n\t  ,[OrderNum] AS [Order Num]\n\t  ,[Workclass] AS [Workclass]\n\t  ,[BudgetUnit] AS [Budget Unit]\n\t  ,[City] AS [City]\n\t  ,[County] AS [County]\n\t  ,IIF([MonthOfService] IS NULL, 0,  [MonthOfService]) AS [Month Of Service]\n\t  ,[AllocationCode] AS [Allocation]\n\t  ,[BatchAgency] AS [Submit Agency]\n\t  ,[BatchSubAgency] AS [Submit Subagency]\n\t  ,CONVERT(varchar,[BatchDate],112) AS [Batch Date]\n\t  ,[BatchType] AS [Batch Type]\n\t  ,[BatchNum] AS [Batch Num]\n\t  ,[BatchSequenceNum] AS [Batch Sequence Num]\n\t  ,[DuplicateRecordInd] AS [Dup Rec Ind]\n\t  ,[WarrantNum] AS [Warrant Num]\n\t  ,IIF([WarrantRegisterNum] = '', 0,  [WarrantRegisterNum]) AS [Warrant Register Num]\n\t  ,'00     0' AS [Prompt Pay Date]\n\t  ,'' AS [Warrant Batch Fiscal Month]\n\t  ,'' AS [Warrant Batch Type]\n\t  ,'' AS [Warrant Batch Num]\n\t  ,CONVERT( char(10), [ProcessDate], 101) + ' ' + CONVERT( char(5), [ProcessDate], 8) AS [Process Date]\n\t  ,'' AS [TAPS Origin]\n\t  ,'' AS [TAPS Status]\n\t  ,'' AS [TAPS Packet Num]\n\t  ,[AccountNum] AS [Account Num]\n\n  FROM [DAILYTRANS].[dbo].[AFRS_DailyTrans_ADDS]\n  WHERE [Agency] = 235\t\t\t\t\t\t\t\t\t--LNI ONLY\n\tAND [PostingFiscalMonth] <> 00\t\t\t\t\t\t--Fiscal Posting Month not equal 00\n\tAND [ProcessDate] >= DateAdd(hh, -24, GETDATE())\t--Transactions Processed in the last 24 hours\n  ORDER BY [AfrsDailyTransAddsId]",
